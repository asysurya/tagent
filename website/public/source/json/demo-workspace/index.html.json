{"path":"demo-workspace/index.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>TaskFlow</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <main class=\"app\">\n    <header>\n      <h1>TaskFlow</h1>\n      <span id=\"task-count\">0 tasks left</span>\n    </header>\n\n    <form id=\"new-task-form\">\n      <input id=\"new-task-input\" type=\"text\" placeholder=\"What needs to be done?\" aria-label=\"New task\" autocomplete=\"off\" />\n      <button type=\"submit\">Add</button>\n    </form>\n\n    <ul id=\"task-list\" aria-label=\"Task list\"></ul>\n\n    <footer>\n      <button id=\"clear-completed\" type=\"button\">Clear completed</button>\n    </footer>\n  </main>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>\n","language":"html","lines":31,"bytes":772,"rawUrl":"/source/raw/demo-workspace/index.html"}